# 环境变量与密钥：只走运行时注入（docker-compose 的 env_file），绝不打包进镜像
.env
.env.*
!.env.example
wxcloudrun*.env.json

# 版本控制与 IDE
.git
.gitignore
.vscode

# Python 运行产物
__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# 本地数据目录：由 compose 挂载 ./data，镜像内不带旧数据
data/

# 测试与文档（scripts/ 保留在镜像内，init_admin 需在容器里执行）
tests/
sql/
*.md
